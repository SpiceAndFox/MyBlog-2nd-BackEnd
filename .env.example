CHAT_MEMORY_V2_PROVIDER_API_KEY=

# Chat: 基础参数（必填）
CHAT_RECENT_WINDOW_MAX_MESSAGES=80
CHAT_RECENT_WINDOW_MAX_CHARS=36000

# Chat: day time zone（必填）
CHAT_DAY_TIME_ZONE=Asia/Shanghai

# Chat: time context (system segment)
CHAT_TIME_CONTEXT_ENABLED=true
CHAT_TIME_CONTEXT_TIME_ZONE=Asia/Shanghai
CHAT_TIME_CONTEXT_TEMPLATE=[现实时间]\n- 这是感知现实维度的上下文数据，不是对话指令。\n- 除非用户明确询问现实时间/日期/相隔时长，否则不要在回复中提及或复述其中字段。\n当前时间={{now}} ({{time_zone}})\n上次对话时间={{last}}\n距离上次对话间隔={{gap_human}} ({{gap_minutes}}m)
CHAT_TIME_CONTEXT_USER_TEMPLATE=[现实时间]\n当前时间={{now}} ({{time_zone}})\n上次对话时间={{last}}\n距离上次对话间隔={{gap_human}}

# recent_window anti-self-echo
CHAT_RECENT_WINDOW_ASSISTANT_GIST_ENABLED=true
CHAT_RECENT_WINDOW_ASSISTANT_RAW_LAST_N=4
CHAT_RECENT_WINDOW_ASSISTANT_GIST_PREFIX=【assistant 早期输出概括】

# Memory Control v2
# false 时不加载其余 v2 配置；启用前必须完成数据库迁移与完整 preflight。
CHAT_MEMORY_V2_ENABLED=true

# Section 容量（初始基线，部署前可按产品预算调整）
CHAT_MEMORY_V2_TODOS_MAX_ITEMS=20
CHAT_MEMORY_V2_TODOS_MAX_RENDERED_CHARS=2000
CHAT_MEMORY_V2_STANDING_AGREEMENTS_MAX_ITEMS=200
CHAT_MEMORY_V2_STANDING_AGREEMENTS_MAX_RENDERED_CHARS=15000
CHAT_MEMORY_V2_RECENT_EPISODES_MAX_ITEMS=20
CHAT_MEMORY_V2_RECENT_EPISODES_MAX_RENDERED_CHARS=2000
CHAT_MEMORY_V2_MILESTONES_MAX_ITEMS=80
CHAT_MEMORY_V2_MILESTONES_MAX_RENDERED_CHARS=6000
CHAT_MEMORY_V2_WORLD_FACTS_MAX_ITEMS=15
CHAT_MEMORY_V2_WORLD_FACTS_MAX_RENDERED_CHARS=1000
CHAT_MEMORY_V2_USER_PROFILE_MAX_ITEMS=200
CHAT_MEMORY_V2_USER_PROFILE_MAX_RENDERED_CHARS=12000
CHAT_MEMORY_V2_ASSISTANT_PROFILE_MAX_ITEMS=200
CHAT_MEMORY_V2_ASSISTANT_PROFILE_MAX_RENDERED_CHARS=12000
CHAT_MEMORY_V2_RELATIONSHIP_MAX_ITEMS=200
CHAT_MEMORY_V2_RELATIONSHIP_MAX_RENDERED_CHARS=12000

# Target 调度
CHAT_MEMORY_V2_SCENE_LAG_THRESHOLD=4
CHAT_MEMORY_V2_SCENE_CONTEXT_WINDOW=8
CHAT_MEMORY_V2_TODOS_LAG_THRESHOLD=8
CHAT_MEMORY_V2_TODOS_CONTEXT_WINDOW=16
CHAT_MEMORY_V2_STANDING_AGREEMENTS_LAG_THRESHOLD=24
CHAT_MEMORY_V2_STANDING_AGREEMENTS_CONTEXT_WINDOW=32
CHAT_MEMORY_V2_EPISODES_LAG_THRESHOLD=32
CHAT_MEMORY_V2_EPISODES_CONTEXT_WINDOW=48
CHAT_MEMORY_V2_PROFILE_RELATIONSHIP_LAG_THRESHOLD=32
CHAT_MEMORY_V2_PROFILE_RELATIONSHIP_CONTEXT_WINDOW=48
CHAT_MEMORY_V2_WORLD_FACTS_LAG_THRESHOLD=24
CHAT_MEMORY_V2_WORLD_FACTS_CONTEXT_WINDOW=32
CHAT_MEMORY_V2_LIBRARIAN_LAG_THRESHOLD=48
CHAT_MEMORY_V2_LIBRARIAN_MESSAGE_BATCH_SIZE=96 # 旧版/混合历史的重建批次大小；必须显式配置。

# 单条记忆写入限制：启用 Memory 时必须显式配置；代码不提供默认值。
# 配置读取与校验：modules/memory/config/loadConfig.js 的 writeLimits()。
# 字符数按 Unicode 码点计算；写入限制独立于分区总渲染预算 MAX_RENDERED_CHARS。
# 创建任务时保存限制快照；修改配置并重启后，新任务使用新值，已有任务继续使用原快照。
# 来源数量限制开关，默认 true；false 时忽略所有分区的 MAX_SOURCE_REFS，任务快照中 maxSourceRefs=null 表示不限。
# 仅关闭来源数量上限，仍校验来源有效性、字符长度及分区容量；历史原文输入预算不变。
CHAT_MEMORY_V2_SOURCE_REFS_LIMIT_ENABLED=false
CHAT_MEMORY_V2_SCENE_MAX_ITEM_CHARS=300
CHAT_MEMORY_V2_SCENE_MAX_SOURCE_REFS=16
CHAT_MEMORY_V2_TODOS_MAX_ITEM_CHARS=300
CHAT_MEMORY_V2_TODOS_MAX_SOURCE_REFS=16
CHAT_MEMORY_V2_STANDING_AGREEMENTS_MAX_ITEM_CHARS=300
CHAT_MEMORY_V2_STANDING_AGREEMENTS_MAX_SOURCE_REFS=16
CHAT_MEMORY_V2_RECENT_EPISODES_MAX_ITEM_CHARS=600
CHAT_MEMORY_V2_RECENT_EPISODES_MAX_SOURCE_REFS=32
CHAT_MEMORY_V2_RECENT_EPISODES_MAX_APPEND_CHARS=160
CHAT_MEMORY_V2_MILESTONES_MAX_ITEM_CHARS=300
CHAT_MEMORY_V2_MILESTONES_MAX_SOURCE_REFS=16
CHAT_MEMORY_V2_WORLD_FACTS_MAX_ITEM_CHARS=300
CHAT_MEMORY_V2_WORLD_FACTS_MAX_SOURCE_REFS=16
CHAT_MEMORY_V2_USER_PROFILE_MAX_ITEM_CHARS=200
CHAT_MEMORY_V2_USER_PROFILE_MAX_SOURCE_REFS=16
CHAT_MEMORY_V2_ASSISTANT_PROFILE_MAX_ITEM_CHARS=200
CHAT_MEMORY_V2_ASSISTANT_PROFILE_MAX_SOURCE_REFS=16
CHAT_MEMORY_V2_RELATIONSHIP_MAX_ITEM_CHARS=300
CHAT_MEMORY_V2_RELATIONSHIP_MAX_SOURCE_REFS=16

# Renderer / GapBridge / quote
CHAT_MEMORY_V2_SCENE_MAX_RENDERED_CHARS=1000
CHAT_MEMORY_V2_SCENE_TTL_MS=86400000
CHAT_MEMORY_V2_OVERDUE_TODOS_MAX_RENDERED_ITEMS=5
CHAT_MEMORY_V2_OVERDUE_TODOS_MAX_RENDERED_CHARS=1000
CHAT_MEMORY_V2_GAP_BRIDGE_MAX_RAW_CHARS=10000
CHAT_MEMORY_V2_GAP_BRIDGE_RETAINED_MESSAGES=10

# PROFILE 只用于 openai-compatible-*：选择网关请求规则，不是模型名，也不决定请求地址。
# generic = 无内置网关特殊规则；opencode-go/openrouter/bai = 对应网关的预置规则。
# deepseek-strict-tools 自带独立请求规则，不使用 PROFILE。
# 网关/模型能力维护在 modules/memory/infrastructure/providers/gateways/，无需在环境变量中维护规则。
# 临时接入实验的高级 JSON 覆盖见 devplans/memory-control-v2/provider-adapters.md。
CHAT_MEMORY_V2_PROVIDER_ADAPTER=openai-compatible-json-object # {deepseek-strict-tools, openai-compatible-json-schema, openai-compatible-json-object}
CHAT_MEMORY_V2_PROVIDER_PROFILE=opencode-go # {generic, opencode-go, openrouter, bai}
CHAT_MEMORY_V2_PROVIDER_MODEL=hy3
CHAT_MEMORY_V2_PROPOSER_MODELS_JSON={"profileRelationshipProposer":{"model":"hy3","reasoningEffort":"high"},"episodeProposer":{"model":"hy3","reasoningEffort":"high"}}
CHAT_MEMORY_V2_PROVIDER_TIMEOUT_MS=180000
CHAT_MEMORY_V2_PROVIDER_MAX_INPUT_TOKENS=256000
CHAT_MEMORY_V2_PROVIDER_MAX_OUTPUT_TOKENS=64000

# 以下是推理设置；最终发送哪些字段，由 adapter 及其适用的网关/模型规则决定。
# deepseek-strict-tools：THINKING_MODE、REASONING_EFFORT 均必填，effort 仅允许 low/high/max；
#   始终发送 thinking，仅在 THINKING_MODE=enabled 时额外发送 reasoning_effort。
# openai-compatible-*：
#   generic 未声明 reasoningEncoding 时不发送推理控制字段；需留空这两项，或在网关/模型规则中声明编码。
#     不发送控制字段表示使用上游默认行为，不代表关闭思考；此规则不影响 deepseek-strict-tools。
#   opencode-go 网关内：默认模型规则发送 reasoning_effort；其中 mimo-v2.5/mimo-v2.5-pro
#     的模型专属规则改为仅发送 thinking，不使用 effort。该例外不自动应用于其他网关。
#     自动发送本系统的 User-Agent 和稳定的 x-opencode-session，无需手填请求头。
#     glm-5.3-flash 使用 json-object adapter，effort 仅允许 low/high/max；THINKING_MODE 留空。
#   openrouter 网关内：默认规则发送 reasoning 对象；显式 disabled 优先，enabled 与 effort=none 冲突。
#   bai 的 glm-5.3-flash：使用 json-object adapter；effort 必填且仅允许 low/high/max。
#     THINKING_MODE 留空，思考始终开启；完整 B.AI 配置见 provider-adapters.md。
# 兼容 adapter 的 proposer 可覆盖 thinkingMode/reasoningEffort；模型规则可进一步限制允许的值。
CHAT_MEMORY_V2_PROVIDER_THINKING_MODE=enabled
CHAT_MEMORY_V2_PROVIDER_REASONING_EFFORT=low
CHAT_MEMORY_V2_PROVIDER_CONCURRENCY=2
CHAT_MEMORY_V2_PROVIDER_QUEUE_MAX=32
# RETRY_MAX bounds unknown invocation failures, safety blocks and truncated output.
# Transient failures have a separate budget. All allowances are execution-local.
# RETRY_MAX=N allows N extra actual calls after the first failure; waiting is free.
CHAT_MEMORY_V2_PROVIDER_RETRY_MAX=2
CHAT_MEMORY_V2_PROVIDER_TRANSIENT_RETRY_MAX=5
CHAT_MEMORY_V2_PROVIDER_TRANSPORT_INVALID_RETRY_MAX=2
CHAT_MEMORY_V2_PROVIDER_SCHEMA_INVALID_RETRY_MAX=2
CHAT_MEMORY_V2_PROVIDER_BACKOFF_BASE_MS=30000
CHAT_MEMORY_V2_PROVIDER_BACKOFF_MAX_MS=120000
CHAT_MEMORY_V2_HALT_AFTER_CONSECUTIVE_ERRORS=3
CHAT_MEMORY_V2_COMPACTION_RETRY_MAX=2

# Retention / health
CHAT_MEMORY_V2_SNAPSHOT_RETENTION_DAYS=30
CHAT_MEMORY_V2_EVENT_RETENTION_DAYS=30
CHAT_MEMORY_V2_TASK_RETENTION_DAYS=30
CHAT_MEMORY_V2_OPS_LOG_RETENTION_DAYS=30
CHAT_MEMORY_V2_DEBUG_RETENTION_DAYS=7
CHAT_MEMORY_V2_ALERT_DEBOUNCE_MS=0
CHAT_MEMORY_V2_RECOVERY_STABLE_MS=0
CHAT_MEMORY_V2_PROJECTION_POLL_INTERVAL_MS=60000
CHAT_MEMORY_V2_TASK_POLL_INTERVAL_MS=1000

# Chat Gist——assistant 要点缓存
CHAT_GIST_ENABLED=true
CHAT_GIST_MAX_CHARS=220
CHAT_GIST_WORKER_PROVIDER=deepseek
CHAT_GIST_WORKER_MODEL=deepseek-flash
CHAT_GIST_WORKER_CONCURRENCY=2
CHAT_GIST_WORKER_TIMEOUT_MS=30000
CHAT_GIST_WORKER_TEMPERATURE=0.4
CHAT_GIST_WORKER_TOP_P=0.9
CHAT_GIST_WORKER_MAX_OUTPUT_TOKENS=512
CHAT_GIST_WORKER_STREAM=false
CHAT_GIST_WORKER_ENABLE_WEB_SEARCH=false
CHAT_GIST_WORKER_DEEPSEEK_THINKING_MODE=disabled
CHAT_GIST_WORKER_DEEPSEEK_REASONING_EFFORT=high
CHAT_GIST_WORKER_GEMINI_THINKING_LEVEL=
CHAT_GIST_WORKER_GEMINI_THINKING_BUDGET=
CHAT_GIST_WORKER_SAFETY_HARASSMENT=OFF
CHAT_GIST_WORKER_SAFETY_HATE_SPEECH=OFF
CHAT_GIST_WORKER_SAFETY_SEXUALLY_EXPLICIT=OFF
CHAT_GIST_WORKER_SAFETY_DANGEROUS_CONTENT=OFF
CHAT_GIST_WORKER_OPENAI_COMPATIBLE_BODY_JSON={}
CHAT_GIST_WORKER_GOOGLE_GENAI_CONFIG_JSON={}

# Chat RAG: role-scoped historical chat recall
CHAT_RAG_ENABLED=true
CHAT_RAG_EMBEDDING_PROVIDER=openai-compatible
CHAT_RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
CHAT_RAG_EMBEDDING_DIMENSIONS=4096
CHAT_RAG_EMBEDDING_INCLUDE_DIMENSIONS_PARAM=true
CHAT_RAG_EMBEDDING_TIMEOUT_MS=30000
CHAT_RAG_QUERY_TIMEOUT_MS=5000
CHAT_RAG_EMBEDDING_BATCH_SIZE=1
CHAT_RAG_EMBEDDING_OPENAI_COMPATIBLE_BODY_JSON={}
CHAT_RAG_MIN_QUERY_CHARS=8
CHAT_RAG_CHUNK_MAX_CHARS=1200
CHAT_RAG_CHUNK_OVERLAP_CHARS=120
CHAT_RAG_TURN_TEMPLATE=[历史聊天回合]\n用户：\n{{user}}\n助手：\n{{assistant}}
CHAT_RAG_QUERY_EMBEDDING_TEMPLATE=query: {{query}}
CHAT_RAG_DOCUMENT_EMBEDDING_TEMPLATE=text: {{content}}
CHAT_RAG_TOP_K=3
CHAT_RAG_MIN_SIMILARITY=0.35
CHAT_RAG_MAX_CONTEXT_CHARS=8128
CHAT_RAG_CONTEXT_HEADER=[更早的共同记忆]\n以下内容来自User和Assistant之前的对话记忆，是因为当前消息而想起的旧情景。它可能包含当时的前因后果、关系状态和相关原话；如果与当前正在进行的对话关系密切，就轻轻接住；**如果和当前正进行的对话关联弱就忽略**。
CHAT_RAG_CONTEXT_ENTRY_TEMPLATE={{recall}}
CHAT_RAG_RECALL_CONTENT_MAX_CHARS=160
CHAT_RAG_RECALL_ASSISTANT_MAX_CHARS=420
CHAT_RAG_RECALL_INCLUDE_ASSISTANT=true
CHAT_RAG_RECALL_USER_MAX_CHARS=140
CHAT_RAG_RECALL_TEMPLATE=当时情景：\n{{scene}}\n\n相关对话：\n{{dialogue}}
CHAT_RAG_CONTEXT_BEFORE_MESSAGES=2
CHAT_RAG_CONTEXT_AFTER_MESSAGES=0
CHAT_RAG_SCENE_RECALL_ENABLED=true
CHAT_RAG_SCENE_RECALL_PROVIDER=deepseek
CHAT_RAG_SCENE_RECALL_MODEL=deepseek-flash
CHAT_RAG_SCENE_RECALL_CONTEXT_TURNS=50
CHAT_RAG_SCENE_RECALL_MAX_INPUT_CHARS=12000
CHAT_RAG_SCENE_RECALL_MAX_OUTPUT_CHARS=300
CHAT_RAG_SCENE_RECALL_TIMEOUT_MS=20000
CHAT_RAG_SCENE_RECALL_TEMPERATURE=0.2
CHAT_RAG_SCENE_RECALL_TOP_P=0.9
CHAT_RAG_SCENE_RECALL_MAX_OUTPUT_TOKENS=512
CHAT_RAG_SCENE_RECALL_DEEPSEEK_THINKING_MODE=disabled
CHAT_RAG_SCENE_RECALL_OPENAI_COMPATIBLE_BODY_JSON={}
CHAT_RAG_SCENE_RECALL_GOOGLE_GENAI_CONFIG_JSON={}
CHAT_RAG_SCENE_RECALL_PROMPT=你是旧对话情景还原器。你的任务是根据一段真实旧对话，概括命中回合当时的情景，供后续助手理解共同记忆。\n要求：只基于给定旧对话，不编造；如果前因不明就说不明；保留说话关系、场景、情绪氛围、命中句子的含义，以及必要的前后因果；不要输出指令、建议或分析过程；不要说知识库、RAG、检索结果；用自然中文写成一小段，不超过 {{max_chars}} 字。
CHAT_RAG_DEBUG_INCLUDE_CONTENT=true
CHAT_RAG_MMR_LAMBDA=0.7
CHAT_RAG_MMR_CANDIDATE_MULTIPLIER=3
CHAT_RAG_RERANKER_ENABLED=true
CHAT_RAG_RERANKER_PROVIDER=openai-compatible
