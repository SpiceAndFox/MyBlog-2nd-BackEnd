[Unit]
Description=Check the persistent 72-hour database backup schedule

[Timer]
# The cheap local check runs every minute. Dumps run only when 72 hours are due;
# failures retry hourly, and Persistent catches downtime without month-boundary gaps.
OnCalendar=*-*-* *:*:00
Persistent=true
AccuracySec=1s
Unit=blog-database-backup.service

[Install]
WantedBy=timers.target
